<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Automata.Core</RootNamespace>
    <AssemblyName>Automata.Core</AssemblyName>
    <!-- Whole-number versioning: major-only bumps (1.0.0 -> 2.0.0 -> 3.0.0). Minor/patch stay 0. -->
    <Version>3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoWebNav" Version="4.0.0" />
    <PackageReference Include="Gherkin" Version="42.0.1" />
    <PackageReference Include="MindAttic.Export" Version="3.0.0" />
    <PackageReference Include="MindAttic.Legion" Version="26.0.0" />
    <PackageReference Include="MindAttic.Log" Version="2.0.0" />
    <PackageReference Include="MindAttic.Vault" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- EF Core 10.0.9 pulls native SQLite 2.1.11, which bundles SQLite < 3.50.2
         (GHSA-2m69-gcr7-jv3q, memory corruption). Pinned to a patched native build. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Automata.Tests" />
  </ItemGroup>

</Project>
