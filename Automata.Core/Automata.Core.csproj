<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Automata.Core</RootNamespace>
    <AssemblyName>Automata.Core</AssemblyName>
    <!-- Whole-number versioning: major-only bumps (1.0.0 → 2.0.0 → 3.0.0). Minor/patch stay 0. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Legion" Version="22.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Automation\Scripts\*.js" />
  </ItemGroup>

</Project>
